# Renombra a hostinger.env y rellena (NO subir a GitHub).
# Este archivo lo usa scripts/deploy-hostinger.ps1

DOMAIN=tu-dominio.com
BASE_URL=https://tu-dominio.com

# MySQL (hPanel → Bases de datos → Management)
DB_HOST=localhost
DB_NAME=u123456789_autoescuela
DB_USER=u123456789_sara
DB_PASS=

# FTP (hPanel → Archivos → Cuentas FTP)
FTP_HOST=ftp.tu-dominio.com
FTP_USER=u123456789
FTP_PASS=
FTP_REMOTE_DIR=/public_html

# Sara — cuenta admin (se crea vía setup.php la primera vez)
ADMIN_EMAIL=sara@tu-dominio.com
SITE_NAME=Autoescuela Sara
